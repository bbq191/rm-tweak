#!/bin/sh
# 假 ssh（packaging/tests 用）：把"远端命令"直接在本机沙箱里执行。"设备" = $CJ_SIM_ROOT。
# 远端绝对路径（/home/root /usr/lib/systemd/system /usr/bin/xochitl /tmp/shelf-0）按 sed 规则改写进沙箱；
# HOME/CJ_SYSD/CJ_PROC 环境指向沙箱，故设备端脚本（及 devlib.sh）无需改写。
R="${CJ_SIM_ROOT:?}"
# CJ_SIM_SSH_FAIL=1：模拟设备连不上（休眠/没插 USB）
if [ -n "${CJ_SIM_SSH_FAIL:-}" ]; then
    echo "ssh $*" >> "$CJ_SIM_LOG"
    echo "ssh: connect to host sim port 22: Connection timed out" >&2
    exit 255
fi
nflag=0
while [ $# -gt 0 ]; do
    case "$1" in
        -n) nflag=1; shift ;;
        -o) shift 2 ;;
        -*) shift ;;
        *) break ;;
    esac
done
shift   # root@host
cmd="$*"
subst() { sed -e "s#/home/root#$R/home/root#g" -e "s#/usr/lib/systemd/system#$R/usr/lib/systemd/system#g" -e "s#/usr/bin/xochitl#$R/usr/bin/xochitl#g" -e "s#/tmp/shelf-0#$R/tmp/shelf-0#g"; }
cmd="$(printf '%s' "$cmd" | subst)"
[ "$nflag" = 1 ] && exec </dev/null
echo "ssh $cmd" >> "$CJ_SIM_LOG"
export HOME="$R/home/root" CJ_SYSD="$R/usr/lib/systemd/system" CJ_PROC="$R/proc"
case "$cmd" in
    "sh -s"*) eval "exec $cmd" ;;
    *) exec sh -c "$cmd" ;;
esac
